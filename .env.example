# Supabase Project -> Connect / API Keys
# Use the project base URL. Do not append /rest/v1/.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Recommended current server-side key (keep this ONLY in Vercel/backend)
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_SECRET_KEY

# Optional legacy fallback for an older Supabase project:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# Generate a long random secret. Example: openssl rand -hex 32
SESSION_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG

# Protects /api/cron-sync. Add the same random value in Vercel.
CRON_SECRET=YOUR_SEPARATE_RANDOM_CRON_SECRET_AT_LEAST_32_CHARACTERS_LONG
